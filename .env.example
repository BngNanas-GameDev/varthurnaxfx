OPENROUTER_API_KEY=
OPENROUTER_PRIMARY=inclusionai/ling-3.0-flash
OPENROUTER_FALLBACK=inclusionai/ling-3.1-flash
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true
BINANCE_DEMO=true
DRY_RUN=true
PAPER_EQUITY=1000
ENABLE_STRATEGY=false
WS_ENABLED=true
WS_STALE_S=10
# WARNING: ALLOW_LIVE gates REAL money. Keep false everywhere except the live
# host env. Preflight FAILS on silent-live (DRY_RUN=false + DEMO=false +
# TESTNET=false without ALLOW_LIVE=true). Never commit a .env with this true.
ALLOW_LIVE=false
# LLM second-opinion (VETO ONLY, worker-3). Default OFF: nol network call,
# loop berperilaku identik seperti tanpa LLM. ON (true) hanya untuk LONG/SHORT:
# VETO -> NO_TRADE + notif Telegram; confidence_mult hanya boleh menurunkan.
LLM_REVIEW=false
# Model review; kosong = default OPENROUTER_PRIMARY. Fallback via OPENROUTER_FALLBACK.
LLM_MODEL=
